# Copy to .env and fill in. Every value can also be set as a real environment variable.

APP_NAME=AeroSculpt
# Public base URL, used in emails and Stripe redirects. Must be https:// in production.
PUBLIC_URL=http://localhost:8000
HOST=127.0.0.1
PORT=8000
# Where the database, uploads and results live. Back this directory up.
DATA_DIR=./data
# 64 random hex characters. Generated into DATA_DIR/.secret_key if left empty.
SECRET_KEY=
# Set to 1 behind HTTPS (defaults to on when PUBLIC_URL is https).
SECURE_COOKIES=
# Number of CFD worker processes started by `run.py serve`. Each uses all CPU cores.
WORKERS=1
SUPPORT_EMAIL=support@example.com

# ---- Stripe ----------------------------------------------------------------------------
# Without STRIPE_SECRET_KEY billing runs in DEMO mode (plans granted without payment).
# Run `python scripts/stripe_setup.py` once to create the products, prices and webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
TRIAL_DAYS=14
# Demo billing grants plans without payment when no Stripe key is set. Defaults to on for
# http:// development URLs and off for https:// deployments. Keep it 0 in production.
ALLOW_DEMO_BILLING=
# Proxy addresses whose X-Forwarded-For header is trusted (for client IPs / rate limits).
FORWARDED_ALLOW_IPS=127.0.0.1

# ---- Email (password resets) -------------------------------------------------------------
# Without SMTP the reset link is written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
